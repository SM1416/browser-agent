# ---- Copy this file to .env and fill it in (setup.sh does it for you) ----

# Your free DuckDNS subdomain, e.g. adam-agent.duckdns.org
DOMAIN=your-name.duckdns.org

# Password for logging in to your website. Pick something long and random.
SITE_PASSWORD=change-me-to-a-long-random-password

# Free Gemini API key from https://aistudio.google.com ("Get API key"). Costs $0.
LLM_API_KEY=

# Gemini model. gemini-2.5-flash is free-tier friendly.
# If Google retires it, pick the current free "Flash" model shown in AI Studio.
LLM_MODEL=gemini-2.5-flash

# Browser timezone (default America/Winnipeg)
TZ=America/Winnipeg

# Max agent steps per task. Each step is ~1-2 Gemini API calls;
# the free tier allows hundreds of requests per day, so 40 is a safe default.
MAX_STEPS=40
